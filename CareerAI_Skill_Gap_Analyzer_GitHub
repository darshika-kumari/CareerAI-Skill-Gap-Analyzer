 \".join(candidate_profile[\"career_interests\"])\n","\n","# Create embeddings\n","career_names = list(career_profiles.keys())\n","career_texts = list(career_profiles.values())\n","\n","candidate_embedding = embedding_model.encode(\n","    candidate_text,\n","    convert_to_tensor=True\n",")\n","\n","career_embeddings = embedding_model.encode(\n","    career_texts,\n","    convert_to_tensor=True\n",")\n","\n","# Calculate semantic similarity\n","similarities = util.cos_sim(\n","    candidate_embedding,\n","    career_embeddings\n",")[0]\n","\n","# Sort careers by similarity\n","career_matches = sorted(\n","    zip(career_names, similarities.tolist()),\n","    key=lambda x: x[1],\n","    reverse=True\n",")\n","\n","print(\"===== CAREER DISCOVERY =====\\n\")\n","\n","for career, score in career_matches[:5]:\n","    print(f\"{career}: {score:.3f}\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"862IpB0I0Oaj"},"outputs":[],"source":["# Create a combined set of skills from the candidate profile\n","candidate_skills = set()\n","\n","for category, skills in candidate_profile[\"skills\"].items():\n","    for skill in skills:\n","        candidate_skills.add(skill.lower())\n","\n","\n","def analyze_skill_gap(career_name):\n","    \"\"\"\n","    Compare the candidate's skills with the skills\n","    associated with a selected career.\n","    \"\"\"\n","\n","    career_text = career_profiles[career_name].lower()\n","\n","    matched = []\n","    missing = []\n","\n","    for skill in candidate_skills:\n","        if skill in career_text:\n","            matched.append(skill)\n","\n","    # Important skills we check for each career\n","    career_skill_requirements = {\n","        \"AI/ML Engineer\": [\n","            \"python\", \"machine learning\", \"deep learning\",\n","            \"neural networks\", \"nlp\", \"transformers\",\n","            \"statistics\", \"data processing\", \"model evaluation\",\n","            \"api