ent level|$)\",\n","        text,\n","        re.IGNORECASE | re.DOTALL\n","    )\n","\n","    if interest_section:\n","\n","        interests = interest_section.group(1)\n","\n","        for line in interests.split(\"\\n\"):\n","\n","            line = line.strip()\n","\n","            if line:\n","                profile[\"career_interests\"].append(line)\n","\n","    return profile\n","\n","\n","candidate_profile = extract_candidate_profile(sample_resume)\n","\n","print(\"Candidate profile restored!\")\n","\n","# ---------- Career profiles ----------\n","career_profiles = {\n","    \"AI/ML Engineer\": \"\"\"\n","    Python, machine learning, deep learning, neural networks, NLP,\n","    transformers, statistics, data processing, model evaluation,\n","    APIs, deployment, Git, Docker and artificial intelligence.\n","    \"\"\",\n","\n","    \"Data Scientist\": \"\"\"\n","    Python, SQL, statistics, probability, data analysis, machine learning,\n","    Pandas, NumPy, data visualization, experimentation and predictive modeling.\n","    \"\"\",\n","\n","    \"Data Analyst\": \"\"\"\n","    SQL, Excel, Python, data cleaning, statistics, dashboards,\n","    Power BI, Tableau, data visualization, business analysis and communication.\n","    \"\"\",\n","\n","    \"Software Engineer\": \"\"\"\n","    Programming, C++, Java, Python, data structures, algorithms,\n","    object-oriented programming, databases, SQL, Git, software development\n","    and problem solving.\n","    \"\"\",\n","\n","    \"Business Analyst\": \"\"\"\n","    Business analysis, requirements gathering, Excel, SQL, communication,\n","    problem solving, documentation, project management and stakeholder management.\n","    \"\"\",\n","\n","    \"Financial Analyst\": \"\"\"\n","    Finance, accounting, Excel, financial modeling, statistics,\n","    economics, data analysis, forecasting, budgeting and business analysis.\n","    \"\"\",\n","\n","    \"Digital Marketing Specialist\": \"\"\"\n","    Market