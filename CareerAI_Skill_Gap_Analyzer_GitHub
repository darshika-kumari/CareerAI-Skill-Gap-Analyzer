\n","    with open(file_path, \"w\", encoding=\"utf-8\") as f:\n","        f.write(content.strip())\n","\n","print(\"Knowledge base created successfully!\")\n","print(\"Files created:\", len(documents))\n","\n","for filename in os.listdir(knowledge_path):\n","    print(\"📄\", filename)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"zR_eGnEos9dA"},"outputs":[],"source":["from sentence_transformers import SentenceTransformer\n","import os\n","\n","# Load the embedding model\n","embedding_model = SentenceTransformer(\"all-MiniLM-L6-v2\")\n","\n","# Read our knowledge-base documents\n","documents_text = []\n","document_names = []\n","\n","for filename in os.listdir(knowledge_path):\n","    if filename.endswith(\".txt\"):\n","        file_path = os.path.join(knowledge_path, filename)\n","\n","        with open(file_path, \"r\", encoding=\"utf-8\") as f:\n","            text = f.read()\n","\n","        documents_text.append(text)\n","        document_names.append(filename)\n","\n","# Convert documents into embeddings\n","embeddings = embedding_model.encode(\n","    documents_text,\n","    convert_to_numpy=True\n",")\n","\n","print(\"Embedding model loaded successfully!\")\n","print(\"Documents:\", len(documents_text))\n","print(\"Embedding shape:\", embeddings.shape)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"1YL9O0jIuD99"},"outputs":[],"source":["import faiss\n","import numpy as np\n","import os\n","\n","# Convert embeddings to float32 for FAISS\n","embeddings = np.asarray(embeddings).astype(\"float32\")\n","\n","# Create a FAISS index\n","dimension = embeddings.shape[1]\n","index = faiss.IndexFlatL2(dimension)\n","\n","# Add our document embeddings\n","index.add(embeddings)\n","\n","# Save the FAISS index\n","index_path = os.path.join(project_path, \"knowledge_base\", \"career_index.faiss\")\n","faiss.write_index(index, index_path)\n","\n","print(\"FAISS vector database created successfully!\")\n","print(\"Number of vectors:\", index.ntotal)\n","print(\"Vector dimension:\", dimension)\n","print(\"Saved to:\", index_path)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"16ehaTGguigR"},"outputs":[],"source":["def search_career_knowledge(query, top_k=2):\n","    # Convert the user's question into an embedding\n","    query_embedding = embedding_model.encode(\n","        [query],\n","        convert_to_numpy=True\n","    ).astype(\"float32\")\n","\n","    # Search the FAISS database\n","    distances, indices = index.search(query_embedding, top_k)\n","\n","    results = []\n","\n","    for distance, idx in zip(distances[0], indices[0]):\n","        results.append({\n","            \"document\": document_names[idx],\n","            \"distance\": float(distance),\n","            \"content\": documents_text[idx]\n","        })\n","\n","    return results\n","\n","\n","# Test our semantic search\n","query = \"What skills do I need to become an AI ML Engineer?\"\n","\n","results = search_career_knowledge(query)\n","\n","print(\"QUERY:\")\n","print(query)\n","print(\"\\nRETRIEVED KNOWLEDGE:\\n\")\n","\n","for i, result in enumerate(results, 1):\n","    print(f\"--- Result {i} ---\")\n","    print(\"Document:\", result[\"document\"])\n","    print(\"Distance:\", result[\"distance\"])\n","    print(result[\"content\"][:500])\n","    print()"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"YXB0UhOuvKvF"},"outputs":[],"source":["def build_context(results):\n","    context = \"\"\n","\n","    for result in results:\n","        context += f\"\"\"\n","SOURCE: {result['document']}\n","\n","{result['content']}\n","\n","-------------------------\n","\"\"\"\n","\n","    return context\n","\n","\n","context = build_context(results)\n","\n","print(context)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true},"id":"ppNYD